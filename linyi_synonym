function findPair(a,b){
  const k = key(a,b);
  let p = P.find(x => key(x.a,x.b) === k) || custom[k];
  if(!p) return null;
  if(p.a !== a) p = flip(p);
  return p;
}
function flip(p){
  return {...p,a:p.b,b:p.a,pa:p.pb,pb:p.pa,ga:p.gb,gb:p.ga,pa_pts:p.pb_pts,pb_pts:p.pa_pts,exA:p.exB,exB:p.exA};
}

function esc(s){ return String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }
function hl(s, a, b){
  let h = esc(s);
  const words = [[a,"a"],[b,"b"]].filter(w => w[0]).sort((x,y)=>y[0].length-x[0].length);
  words.forEach(([w,c]) => { h = h.split(esc(w)).join(`<mark class="m${c}">${esc(w)}</mark>`); });
  return h;
}
const SPK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7"/></svg>';
function say(t){
  try{
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(t); u.lang = "zh-TW"; u.rate = .85;
    const v = speechSynthesis.getVoices().find(v => /zh[-_]TW/i.test(v.lang)) || speechSynthesis.getVoices().find(v => /^zh/i.test(v.lang));
    if(v) u.voice = v;
    speechSynthesis.speak(u);
  }catch(e){}
}
const hasTTS = "speechSynthesis" in window;
function sayBtn(t){ return hasTTS ? `<button class="say" data-say="${esc(t)}" aria-label="朗讀 read aloud">${SPK}</button>` : ""; }

const pyOf = x => esc(x && (x.py || PY[x.zh]) || "");
const pyl = x => { const t = pyOf(x); return t ? `<span class="pyl">${t}</span>` : ""; };
function render(p, ai){
  const pts = arr => (arr||[]).map(x => `<li>${esc(x.zh)}${pyl(x)}<span class="en">${esc(x.en)}</span></li>`).join("");
  const exs = (arr) => (arr||[]).map(x => `<li>${sayBtn(x.zh)}<div><span class="zh">${hl(x.zh,p.a,p.b)}</span>${pyl(x)}<span class="en">${esc(x.en)}</span></div></li>`).join("");
  const sw = (p.swap||[]).map(x => `<li><span class="mk ${x.ok?"ok":"no"}" aria-label="${x.ok?"正確":"錯誤"}">${x.ok?"✓":"✗"}</span><div><span class="zh ${x.ok?"":"no"}">${esc(x.zh)}</span>${pyl(x)}<span class="en">${esc(x.en)}</span></div></li>`).join("");
  $("#out").innerHTML = `
  <section class="face" aria-label="兩個詞">
    <div class="side a"><div class="word">${esc(p.a)}<span class="py">${esc(p.pa)}</span></div><p class="gloss">${esc(p.ga)}</p></div>
    <div class="side b"><div class="word">${esc(p.b)}<span class="py">${esc(p.pb)}</span></div><p class="gloss">${esc(p.gb)}</p></div>
    <div class="shared"><b>共同點</b>　${esc(p.shared?.zh)}${pyl(p.shared)}<span class="en">${esc(p.shared?.en)}</span></div>
  </section>

  <h2>用法重點 <span class="en" style="display:inline">How each is used</span></h2>
  <div class="cols">
    <div class="col a"><h3>${esc(p.a)}</h3><ul>${pts(p.pa_pts)}</ul></div>
    <div class="col b"><h3>${esc(p.b)}</h3><ul>${pts(p.pb_pts)}</ul></div>
  </div>

  <h2>例句 <span class="en" style="display:inline">Example sentences</span></h2>
  <div class="cols">
    <div class="col a"><h3>${esc(p.a)}</h3><ul class="ex">${exs(p.exA)}</ul></div>
    <div class="col b"><h3>${esc(p.b)}</h3><ul class="ex">${exs(p.exB)}</ul></div>
  </div>

  <h2>放在一起比較 <span class="en" style="display:inline">One sentence, both words</span></h2>
  <div class="contrast">${sayBtn(p.contrast?.zh)}<div>${hl(p.contrast?.zh,p.a,p.b)}${pyl(p.contrast)}<span class="en">${esc(p.contrast?.en)}</span></div></div>

  <h2>可以互換嗎？ <span class="en" style="display:inline">Can you swap them?</span></h2>
  <ul class="swap">${sw}</ul>

  <h2>練習一下 <span class="en" style="display:inline">Practice: pick the word that fits</span></h2>
  <div id="quizbox"></div>
  ${ai ? `<p class="ai-note">這組解釋由 AI 產生，建議跟老師確認。<span class="en">This explanation was generated by AI. Check it with your teacher.</span></p>` : ""}`;
  renderQuiz(p);
}


function getQuiz(p){ return p.quiz || QZ[p.a+"|"+p.b] || QZ[p.b+"|"+p.a] || []; }
function shuffle(a){ a=a.slice(); for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; }
function renderQuiz(p, reshuffle){
  const box = $("#quizbox"); if(!box) return;
  const items = reshuffle ? shuffle(getQuiz(p)) : getQuiz(p);
  if(!items.length){ box.innerHTML = '<p class="en">這組詞還沒有練習題。 No practice items for this pair yet.</p>'; return; }
  let done = 0, right = 0;
  box.innerHTML = `<ol class="quiz">${items.map((x,i)=>{
    const [pre,post] = x.q.split("___");
    return `<li data-i="${i}"><div class="qs"><span>${esc(pre)}<span class="blank">&nbsp;</span>${esc(post||"")}</span></div>${x.py?`<span class="pyl">${esc(x.py)}</span>`:""}
      <div class="opts"><button class="opt oa" data-v="${esc(p.a)}">${esc(p.a)}</button><button class="opt ob" data-v="${esc(p.b)}">${esc(p.b)}</button><button class="opt" data-v="both">兩個都可以 Both</button></div>
      <p class="fb" hidden></p></li>`;}).join("")}</ol><div class="score" hidden></div>`;
  box.querySelectorAll(".quiz>li").forEach(li => {
    const x = items[+li.dataset.i];
    li.querySelector(".opts").addEventListener("click", e => {
      const btn = e.target.closest(".opt"); if(!btn || btn.disabled) return;
      const ok = btn.dataset.v === x.ans;
      li.querySelectorAll(".opt").forEach(o => { o.disabled = true; if(o.dataset.v === x.ans) o.classList.add("right"); });
      if(!ok) btn.classList.add("wrong");
      const word = x.ans === "both" ? p.a + "／" + p.b : x.ans;
      const wpy = x.ans === "both" ? p.pa + " / " + p.pb : (x.ans === p.a ? p.pa : p.pb);
      const bl = li.querySelector(".blank"); bl.textContent = word; bl.classList.add("done");
      bl.innerHTML = `<mark class="${x.ans===p.b?"mb":"ma"}">${esc(word)}</mark>`;
      const pl = li.querySelector(".pyl"); if(pl && wpy) pl.textContent = x.py.replace("___", wpy);
      const fb = li.querySelector(".fb"); fb.hidden = false;
      fb.innerHTML = `<b class="${ok?"ok":"no"}">${ok?"答對了！ Correct.":"再想想。 Not quite."}</b> ${esc(x.en)} ${hasTTS?`<button class="say" style="display:inline-grid;vertical-align:middle;margin-left:6px" data-say="${esc(x.q.replace("___", x.ans==="both"?p.a:x.ans))}" aria-label="朗讀 read aloud">${SPK}</button>`:""}`;
      done++; if(ok) right++;
      if(done === items.length){
        const sc = box.querySelector(".score"); sc.hidden = false;
        sc.innerHTML = `<span>${right} / ${items.length} 答對 correct${right===items.length?"，太棒了！":""}</span><button class="again">再練一次 Try again</button>`;
        sc.querySelector(".again").onclick = () => { renderQuiz(p, true); box.scrollIntoView({block:"start"}); };
      }
    });
  });
}

function setStatus(t, err){ const s=$("#status"); s.textContent=t; s.className = "status" + (err?" err":""); }

function drawChips(cur){
  const all = P.map(p=>[p.a,p.b,false]).concat(Object.values(custom).map(p=>[p.a,p.b,true]));
  $("#chips").innerHTML = all.map(([a,b,c]) =>
    `<button class="chip${c?" custom":""}" data-a="${esc(a)}" data-b="${esc(b)}" aria-pressed="${cur===key(a,b)}">${esc(a)}／${esc(b)}</button>`).join("");
}

let samplePromise = (window.claude && claude.use) ? claude.use("sample").catch(()=>null) : Promise.resolve(null);
let busy = false;

async function compare(a,b){
  a = a.trim(); b = b.trim();
  if(!a || !b){ setStatus("請輸入兩個詞。 Enter two words.", true); return; }
  if(a === b){ setStatus("這兩個詞一樣，請換一個。 The two words are the same.", true); return; }
  $("#wa").value = a; $("#wb").value = b;
  const p = findPair(a,b);
  if(p){ setStatus(""); render(p, !!custom[key(a,b)]); drawChips(key(a,b)); return; }
  if(busy) return;
  const sample = await samplePromise;
  if(!sample){ setStatus(`「${a}／${b}」還沒有內建解釋。請從上面的詞組選一個。 This pair isn't built in yet.`, true); return; }
  busy = true; $("#go").disabled = true;
  setStatus("正在比較這兩個詞…（大約 10 到 40 秒） Comparing…");
  const prompt = `You are an expert teacher of Mandarin as used in Taiwan, writing for an adult English-speaking learner who is a career coach in the tech industry. Compare the two words 「${a}」 and 「${b}」.
Use Traditional Chinese characters and Taiwan usage. Keep each Chinese line short (under 30 characters). Set example and practice sentences in career-coaching contexts wherever natural (coaching sessions, coach and client conversations, goals, feedback, leading a team, one-on-ones). Avoid topics about quitting a job, changing jobs, job hunting, interviews, offers, or layoffs. English lines are plain, short translations or explanations. Do not use em dashes.
If either input is not a real word, still do your best and explain in "shared".
Every object that has a "zh" field must also have a "py" field: Hanyu Pinyin with tone marks for that zh line, one space between syllables, tone sandhi marked for 一 and 不, neutral tones where standard (e.g. shén me, wǒ men, qīng chu), and ASCII punctuation.
Return ONLY a JSON object, no markdown, with exactly these keys:
{"a":"${a}","b":"${b}","pa":"pinyin with tone marks for a","pb":"pinyin for b","ga":"short English gloss of a","gb":"short English gloss of b",
"shared":{"zh":"one short line on what they share","py":"pinyin","en":"one sentence stating the core difference"},
"pa_pts":[{"zh":"usage point for a","en":"English"},{"zh":"","en":""}],
"pb_pts":[{"zh":"usage point for b","en":"English"},{"zh":"","en":""}],
"exA":[{"zh":"example sentence containing ${a}","en":"translation"},{"zh":"","en":""}],
"exB":[{"zh":"example sentence containing ${b}","en":"translation"},{"zh":"","en":""}],
"contrast":{"zh":"one sentence that uses both words to show the difference","en":"translation"},
"swap":[{"zh":"a sentence where swapping in the other word is wrong (write the wrong version)","ok":false,"en":"why it's wrong and the correct word"},{"zh":"a sentence where both work, written as 詞A／詞B inline","ok":true,"en":"nuance"}],
"quiz":[4 fill-in-the-blank items, each {"q":"a new sentence (not reused from above) with ___ where the word goes","py":"pinyin of q, keeping ___ in place","ans":"exactly ${a} or exactly ${b}, or \"both\" only if both are fully natural","en":"one short English reason"}; at least one answer ${a} and one ${b}]}`;
  try{
    const r = await sample.json(prompt, {modelTier:"default"});
    if(!r || !r.a || !r.exA) throw {code:"bad"};
    r.a = a; r.b = b;
    custom[key(a,b)] = r; saveCustom();
    setStatus(""); render(r, true); drawChips(key(a,b));
  }catch(e){
    const m = {not_granted:"需要允許才能產生新的解釋。 Allow access to generate new pairs.",
               rate_limited:"請求太多，請稍等一分鐘再試。 Too many requests; wait a minute and try again.",
               cancelled:"已取消。 Cancelled."};
    setStatus(m[e && e.code] || "沒辦法產生這組解釋，請再試一次。 Couldn't generate this pair; try again.", true);
  }finally{ busy = false; $("#go").disabled = false; }
}

$("#go").addEventListener("click", () => compare($("#wa").value, $("#wb").value));
["#wa","#wb"].forEach(s => $(s).addEventListener("keydown", e => { if(e.key==="Enter") compare($("#wa").value, $("#wb").value); }));
$("#chips").addEventListener("click", e => { const c = e.target.closest(".chip"); if(c) compare(c.dataset.a, c.dataset.b); });
$("#out").addEventListener("click", e => { const b = e.target.closest("[data-say]"); if(b) say(b.dataset.say); });
if(hasTTS){ speechSynthesis.getVoices(); speechSynthesis.onvoiceschanged = () => speechSynthesis.getVoices(); }
drawChips("");
let showPy = true;
try { showPy = localStorage.getItem("synpy") !== "0"; } catch(e){}
function applyPy(){ document.body.classList.toggle("nopy", !showPy); $("#pytog").setAttribute("aria-pressed", String(showPy)); }
$("#pytog").addEventListener("click", () => { showPy = !showPy; try{ localStorage.setItem("synpy", showPy ? "1" : "0"); }catch(e){} applyPy(); });
applyPy();
</script>
</body>
</html>
